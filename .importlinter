[importlinter]
root_package = qap

[importlinter:qap_package_layers]
name = QAP package dependency direction
type = layers
layers =
    (qap.api)
    (qap.experiment)
    (qap.evaluation)
    (qap.execution)
    (qap.policy)
    (qap.relationship)
    (qap.market)
    (qap.portfolio)

[importlinter:qap_evaluation_execution_independence]
name = Evaluation and execution remain independent
type = layers
layers =
    (qap.execution)
    (qap.evaluation)

[importlinter:qap_evaluation_policy_independence]
name = Evaluation and policy remain independent
type = layers
layers =
    (qap.policy)
    (qap.evaluation)

[importlinter:qap_evaluation_relationship_independence]
name = Evaluation and relationship remain independent
type = layers
layers =
    (qap.relationship)
    (qap.evaluation)

[importlinter:qap_execution_relationship_independence]
name = Execution and relationship remain independent
type = layers
layers =
    (qap.relationship)
    (qap.execution)

[importlinter:qap_scanner_no_financial_authority]
name = Scanner remains outside financial authority
type = forbidden
source_modules =
    qap.scanner
forbidden_modules =
    qap.policy
    qap.execution
    qap.evaluation
    qap.experiment
ignore_imports =
    qap.scanner.cli -> qap.scanner_entry

[importlinter:qap_financial_core_no_scanner]
name = Financial core never depends on scanner
type = forbidden
source_modules =
    qap.portfolio
    qap.market
    qap.relationship
    qap.policy
    qap.execution
    qap.evaluation
forbidden_modules =
    qap.scanner

[importlinter:qap_experiment_scanner_adapter_only]
name = Experiment scanner dependency is limited to scanner adapter
type = forbidden
source_modules =
    qap.experiment
forbidden_modules =
    qap.scanner
ignore_imports =
    qap.experiment.scanner_adapter -> qap.scanner.**
