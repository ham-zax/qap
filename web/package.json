{
  "name": "qap-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "e2e": "cd .. && uv run python scripts/run_playwright_e2e.py",
    "typecheck": "tsc --noEmit",
